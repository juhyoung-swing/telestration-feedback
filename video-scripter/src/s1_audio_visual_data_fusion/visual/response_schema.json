{
  "type": "object",
  "properties": {
    "exclusions": {
      "type": "array",
      "description": "잘라내야 할 구간. 확실하지 않으면 넣지 않는다. 빈 배열도 유효한 답이다.",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
