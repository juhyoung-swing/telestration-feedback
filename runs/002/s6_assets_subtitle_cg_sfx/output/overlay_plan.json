 "speech_cues": 97,
 "items": [
  {
   "kind": "speech",
   "start": 0.0,
   "end": 1.26,
   "what": "안녕하세요. 김준코치입니다."
  },
  {
   "kind": "graphic",
   "start": 0.5,
   "end": 2.5,
   "what": "코치 이름"
  },
  {
   "kind": "speech",
   "start": 1.4,
   "end": 7.18,
   "what": "오늘 포핸드 제가 제일 중요하게 생각하는 세 / 가지를 혼자 티칭을 해볼까 하는데"
  },
  {
   "kind": "speech",
   "start": 7.18,
   "end": 16.18,
   "what": "첫째는 시선 거리 잡기, 두 번째는 골반 / 회전 사용하는 법, 세 번째는 마무리"
  },
  {
   "kind": "title",
   "start": 7.5,
   "end": 10.0,
   "what": "1. 시선 (거리잡기)"
  },
  {
   "kind": "title",
   "start": 10.5,
   "end": 13.0,
   "what": "2. 골반 회전"
  },
  {
   "kind": "title",
   "start": 13.5,
   "end": 16.0,
   "what": "3. 마무리 피니시"
  },
  {
   "kind": "speech",
   "start": 16.18,
   "end": 19.08,
   "what": "피니시까지 한번 다뤄보려고 합니다."
  },
  {
   "kind": "speech",
   "start": 19.52,
   "end": 21.84,
   "what": "이제 제가 세 가지를 제일 중요시하는 것은"
  },
  {
   "kind": "speech",
   "start": 21.84,
   "end": 25.38,
   "what": "어쨌든 이 세 가지가 완벽하게 돼야 파워도 / 실릴 수 있고"
  },
  {
   "kind": "speech",
   "start": 25.38,
   "end": 29.56,
   "what": "그 다음에 정확도도 올라가고 내가 원하는 / 코스에다 보낼 수 있기 때문에"
  },
  {
   "kind": "speech",
   "start": 29.56,
   "end": 31.6,
   "what": "제일 중요한 세 가지라고 생각합니다."
  },
  {
   "kind": "speech",
   "start": 31.7,
   "end": 33.92,
   "what": "그러면 한번 가보실게요."
  },
  {
   "kind": "title",
   "start": 35.0,
   "end": 37.5,
   "what": "시선 (거리잡기)"
  },
  {
   "kind": "speech",
   "start": 37.5,
   "end": 40.68,
   "what": "처음에는 시선, 거리잡기인데"
  },
  {
   "kind": "title",
   "start": 38.0,
   "end": 41.0,
   "what": "거리잡기를 어려워하는 이유?"
  },
  {
   "kind": "speech",
   "start": 40.68,
   "end": 44.08,
   "what": "이제 대부분 거리가 다 안 잡히는 이유는"
  },
  {
   "kind": "speech",
   "start": 44.08,
   "end": 48.24,
   "what": "정면으로 보고 가다 보니까 땡기는 승이 / 많아져요"
  },
  {
   "kind": "speech",
   "start": 48.24,
   "end": 53.14,
   "what": "대부분은 멀어서 실수하는 것보다 가까워서 / 실수하는 경우가 많거든요"
  },
  {
   "kind": "speech",
   "start": 53.14,
   "end": 56.98,
   "what": "이 이유는 저희가 공을 볼 때 처음에 / 상대방을 보면"
  },
  {
   "kind": "speech",
   "start": 56.98,
   "end": 62.34,
   "what": "포핸드라고 결정이 지어졌을 때는 옆을 향해서 / 보고 가야"
  },
  {
   "kind": "speech",
   "start": 62.34,
   "end": 66.18,
   "what": "타점 자체를 옆에다 두고 거기에 멀리 두게 / 되는데"
  },
  {
   "kind": "speech",
   "start": 66.18,
   "end": 72.64,
   "what": "대부분의 가까운 분들을 보면 첫 스텝이 / 정면으로 빠지게 되다 보니까"
  },
  {
   "kind": "speech",
   "start": 72.64,
   "end": 81.38,
   "what": "마무리 공도 정면에서 자꾸 이렇게 눕거나 / 아니면 가까워서 당기고 자세가 무너지게"
  },
  {
   "kind": "speech",
   "start": 81.38,
   "end": 82.38,
   "what": "돼요."
  },
  {
   "kind": "speech",
   "start": 81.68,
   "end": 84.96,
   "what": "첫째, 내가 포핸드로 결정을 했다"
  },
  {
   "kind": "speech",
   "start": 84.96,
   "end": 88.08,
   "what": "그러면 유니턴을 하면서 상대방을 째려보는 / 거예요"
  },
  {
   "kind": "title",
   "start": 85.0,
   "end": 88.0,
   "what": "(어 포핸드쪽으로 공이 오네?)"
  },
  {
   "kind": "graphic",
   "start": 85.5,
   "end": 91.0,
   "what": "arrow → 시선 방향 · 줌 보정 (917,655)→ @ (835,752) 인물폭 330px"
  },
  {
   "kind": "speech",
   "start": 88.08,
   "end": 94.06,
   "what": "째려보게 되면 나도 모르게 공을 정면에 두면 / 옆이 정면이 되게 되죠"
  },
  {
   "kind": "speech",
   "start": 94.06,
   "end": 96.2,
   "what": "그래서 시선이 옆이 정면이 되게 되다 보니까"
  },
  {
   "kind": "speech",
   "start": 96.2,
   "end": 99.3,
   "what": "거리를 정확하게 멀리 두게 돼요"
  },
  {
   "kind": "speech",
   "start": 99.3,
   "end": 102.7,
   "what": "그리고 이 미세한 차이는 어디서 잡냐면"
  },
  {
   "kind": "speech",
   "start": 102.7,
   "end": 107.18,
   "what": "이 미세한 차이는 저희가 공을 끝까지 봄에 / 따라서"
  },
  {
   "kind": "speech",
   "start": 107.18,
   "end": 110.74,
   "what": "조금의 변화에 되는 공을 라켓을 따라갈 수가 / 있어요"
  },
  {
   "kind": "speech",
   "start": 110.74,
   "end": 117.24,
   "what": "대부분 이 상태에서 임팩트 전에 고개를 / 돌리시는 분들은 여기를 못 따라가게 되니까"
  },
  {
   "kind": "speech",
   "start": 117.24,
   "end": 122.4,
   "what": "예측해서 그냥 스윙을 휘둘러서 타점이 이렇게 / 정확하게 안 맞게 돼요."
  },
  {
   "kind": "speech",
   "start": 122.52,
   "end": 133.52,
   "what": "근데 저희가 만약 시선을 계속 임팩트까지 / 가져간다면 공이"
  },
  {
   "kind": "speech",
   "start": 133.52,
   "end": 136.96,
   "what": "그리고 멀어져도 발이 따라가게 되고"
  },
  {
   "kind": "speech",
   "start": 136.96,
   "end": 140.48,
   "what": "그 다음에 가까우면 내가 스윙을 돌리게 돼요"
  },
  {
   "kind": "speech",
   "start": 140.48,
   "end": 143.26,
   "what": "그러니까 임팩트를 받기 때문에 이건 돌아가는 / 거고"
  },
  {
   "kind": "speech",
   "start": 143.26,
   "end": 146.96,
   "what": "그래서 거리 잡는 데는 무조건 유니턴 1번"
  },
  {
   "kind": "title",
   "start": 143.5,
   "end": 146.0,
   "what": "1. 유닛턴"
  },
  {
   "kind": "title",
   "start": 146.5,
   "end": 149.0,
   "what": "2. 공 째려보기"
  },
  {
   "kind": "speech",
   "start": 146.96,
   "end": 151.86,
   "what": "그 다음에 저희가 유니턴 한 후에 공을 / 째려보기"
  },
  {
   "kind": "title",
   "start": 149.5,
   "end": 152.5,
   "what": "3. 임팩트까지 바라보기"
  },
  {
   "kind": "speech",
   "start": 151.86,
   "end": 156.08,
   "what": "그 다음에 임팩트 하는 순간까지 바라보기"
  },
  {
   "kind": "speech",
   "start": 156.08,
   "end": 159.62,
   "what": "이렇게 되면 스윙이 자연스럽게 나오게 됩니다"
  },
  {
   "kind": "speech",
   "start": 159.62,
   "end": 162.9,
   "what": "일단은 첫 번째는 이게 해결했고요"
  },
  {
   "kind": "title",
   "start": 170.4,
   "end": 172.9,
   "what": "골반 사용 (회전)"
  },
  {
   "kind": "speech",
   "start": 172.9,
   "end": 178.64,
   "what": "자, 두 번째는 이제 거리를 잡았으니까 골반 / 사용입니다. 회전."
  },
  {
   "kind": "speech",
   "start": 178.74,
   "end": 184.4,
   "what": "회전은 뭐가 중요하냐면 회원분들이 볼 때 / 골반을 사용하지 못하기 때문에"
  },
  {
   "kind": "speech",
   "start": 184.4,
   "end": 188.66,
   "what": "파워가 제일 안 실려요. 그 이유는 오른발을 / 잘 보시면"
  },
  {
   "kind": "speech",
   "start": 188.66,
   "end": 192.98,
   "what": "오른발이 축이 뒤로 가 있게 되면 자꾸 뒤로 / 무너집니다."
  },
  {
   "kind": "speech",
   "start": 193.48,
   "end": 197.34,
   "what": "그래서 지금 저희가 스탠스를 왼발을 잡아서 / 누르고"
  },
  {
   "kind": "graphic",
   "start": 193.7,
   "end": 196.7,
   "what": "circle → 오른발 축 · 줌 보정 (944,1028)→ @ (996,997) 인물폭 460px"
  },
  {
   "kind": "speech",
   "start": 197.34,
   "end": 201.38,
   "what": "제일 중요한 건 여기서 오른발을 먼저 사용해 / 줌으로써"
  },
  {
   "kind": "speech",
   "start": 201.38,
   "end": 203.06,
   "what": "골반 회전을 만드는 거예요."
  },
  {
   "kind": "graphic",
   "start": 201.4,
   "end": 203.4,
   "what": "arc_arrow → 골반 회전 방향 · 줌 보정 (1019,831)→ @ (1117,682) 인물폭 460px"
  },
  {
   "kind": "speech",
   "start": 203.16,
   "end": 205.4,
   "what": "여기서 골반 회전이 만들어져야"
  },
  {
   "kind": "speech",
   "start": 205.4,
   "end": 210.16,
   "what": "뒷달려 나오면서 채찍처럼 파워를 땅 내게 / 되는데"
  },
  {
   "kind": "speech",
   "start": 210.16,
   "end": 213.74,
   "what": "오른발을 고정시키고 뒤로 빠지게 되면"
  },
  {
   "kind": "speech",
   "start": 214.66,
   "end": 216.84,
   "what": "당기게 되니까 파워를 낼 수가 없어요."
  },
  {
   "kind": "speech",
   "start": 216.84,
   "end": 220.06,
   "what": "그래서 제일 중요한 것은 디딤발도 / 디딤바르지만"
  },
  {
   "kind": "speech",
   "start": 220.06,
   "end": 225.24,
   "what": "내가 오른발에 회전을 함으로써 라켓보다 먼저 / 골반을 회전해주는 것"
  },
  {
   "kind": "speech",
   "start": 225.24,
   "end": 229.34,
   "what": "이 회전하는 순간이 가장 파워를 낼 수 있는 / 중요한 순간입니다"
  },
  {
   "kind": "speech",
   "start": 229.34,
   "end": 232.3,
   "what": "그런데 여기서 한 가지 더 중요한 것은"
  },
  {
   "kind": "speech",
   "start": 232.3,
   "end": 236.14,
   "what": "이 골반을 사용한다고 해서 오른발을 여기서 / 딱 버티는 게 아니라"
  },
  {
   "kind": "speech",
   "start": 236.14,
   "end": 239.28,
   "what": "자연스럽게 내가 끌려나가는 것"
  },
  {
   "kind": "speech",
   "start": 239.28,
   "end": 243.66,
   "what": "이 공의 스윙 스피드에 따라 발을 버티면 안 / 되고"
  },
  {
   "kind": "speech",
   "start": 243.66,
   "end": 247.22,
   "what": "오히려 그냥 가듯이 끌려 나가야 돼요."
  },
  {
   "kind": "speech",
   "start": 247.28,
   "end": 251.3,
   "what": "이게 끌려 나가줌으로써 회전이 자연스럽게 / 완성됩니다."
  },
  {
   "kind": "title",
   "start": 252.6,
   "end": 255.1,
   "what": "1. 오른발 돌리며 골반 회전"
  },
  {
   "kind": "speech",
   "start": 252.68,
   "end": 260.26,
   "what": "다시 한번 보여드리면 골반 회전이 오른발을 / 돌리면서 몸이 먼저 따라가고"
  },
  {
   "kind": "title",
   "start": 255.6,
   "end": 258.1,
   "what": "2. 몸이 먼저 따라감"
  },
  {
   "kind": "title",
   "start": 258.6,
   "end": 261.1,
   "what": "3. 라켓을 채찍처럼"
  },
  {
   "kind": "speech",
   "start": 260.26,
   "end": 264.14,
   "what": "그 다음에 라켓을 치는 동작이 나옵니다."
  },
  {
   "kind": "title",
   "start": 273.14,
   "end": 275.64,
   "what": "피니시 자세"
  },
  {
   "kind": "speech",
   "start": 275.64,
   "end": 278.48,
   "what": "자, 세 번째는 피니시입니다."
  },
  {
   "kind": "speech",
   "start": 279.2,
   "end": 284.48,
   "what": "여기서 첫 번째, 두 번째를 저희가 시선, / 골반을 잘했는데"
  },
  {
   "kind": "speech",
   "start": 284.48,
   "end": 287.24,
   "what": "잘하고도 스윙이 안 나오시는 분들이 꼭 / 있어요."
  },
  {
   "kind": "speech",
   "start": 287.4,
   "end": 291.9,
   "what": "그 이유는 마지막 피니시를 겨드랑이와 팔을 / 붙어서"
  },
  {
   "kind": "graphic",
   "start": 287.44,
   "end": 290.44,
   "what": "circle → 겨드랑이–팔 사이 공간 @ (990,638) 인물폭 245px"
  },
  {
   "kind": "speech",
   "start": 291.9,
   "end": 293.94,
   "what": "당기는 스윙을 나올 때"
  },
  {
   "kind": "speech",
   "start": 293.94,
   "end": 297.08,
   "what": "그럴 때는 뒤에 테이크백을 잘 만들어 놓고도"
  },
  {
   "kind": "speech",
   "start": 297.08,
   "end": 299.48,
   "what": "안 나오는 스윙이 완성이 되기 때문에"
  },
  {
   "kind": "speech",
   "start": 299.48,
   "end": 301.32,
   "what": "제가 회원들한테 뭘 시키냐면"
  },
  {
   "kind": "speech",
   "start": 301.32,
   "end": 307.78,
   "what": "이 공간에, 이 공의 큰 공이 가슴이랑 팔 / 사이에 있다고 생각하고"
  },
  {
   "kind": "title",
   "start": 305.64,
   "end": 308.14,
   "what": "이렇게 스윙을 만드는 이유는?"
  },
  {
   "kind": "speech",
   "start": 307.78,
   "end": 310.4,
   "what": "피니쉬 공간을 크게 만들라고 합니다."
  },
  {
   "kind": "speech",
   "start": 310.56,
   "end": 312.88,
   "what": "그러면 이 피니쉬가 자연스럽게 나오면서"
  },
  {
   "kind": "speech",
   "start": 312.88,
   "end": 315.34,
   "what": "선수들이 하는 피니쉬를 만들 수 있는데"
  },
  {
   "kind": "speech",
   "start": 315.34,
   "end": 318.26,
   "what": "그럴 때는 제가 항상 회원들한테 시키는 게"
  },
  {
   "kind": "speech",
   "start": 318.26,
   "end": 320.18,
   "what": "골반 임팩트 해결하고"
  },
  {
   "kind": "speech",
   "start": 320.18,
   "end": 324.34,
   "what": "그 다음에 이 오른손 팔꿈치를 왼손바닥으로 / 밀어주고"
  },
  {
   "kind": "speech",
   "start": 324.34,
   "end": 327.78,
   "what": "그대로 올라가면서 피니쉬를 만들면"
  },
  {
   "kind": "speech",
   "start": 327.78,
   "end": 329.38,
   "what": "근데 이것도 어렵다 그러면"
  },
  {
   "kind": "graphic",
   "start": 330.64,
   "end": 333.14,
   "what": "object_basketball → 가슴–팔 사이 공간 · 줌 보정 (986,655)→ @ (995,802) 인물폭 366px"
  },
  {
   "kind": "speech",
   "start": 330.94,
   "end": 333.26,
   "what": "농구공 다이소에 다 있을 거예요"
  },
  {
   "kind": "speech",
   "start": 333.26,
